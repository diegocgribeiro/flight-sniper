# Postgres (Neon) — connection string com pooler e sslmode=require
DATABASE_URL=

# Login do site (usuário único)
APP_PASSWORD=
# Segredo para assinar o cookie de sessão (mín. 16 caracteres): openssl rand -base64 32
AUTH_SECRET=

# E-mail padrão de alerta (mostrado no formulário)
ALERT_EMAIL=

# Opcional: botão "Buscar agora" (dispara o workflow do GitHub Actions)
# Fine-grained token com acesso só a este repo: Actions = Read and write
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=diegocgribeiro/flight-sniper

# Segredo do /api/cron chamado pelo cron-job.org (header Authorization: Bearer <valor>)
CRON_SECRET=
# Servidor ntfy (opcional)
NTFY_SERVER=https://ntfy.sh
