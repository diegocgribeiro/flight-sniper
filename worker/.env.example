# Mesma base do site
DATABASE_URL=

# Resend (https://resend.com) — sem domínio próprio, só envia para o e-mail da sua conta Resend
RESEND_API_KEY=
RESEND_FROM=Flight Sniper <onboarding@resend.dev>
ALERT_EMAIL=

# URL pública do site (links no e-mail)
APP_URL=https://flight-sniper.vercel.app

# Ajustes finos (opcionais)
APP_TIMEZONE=America/Sao_Paulo
REQUEST_DELAY_SECONDS=1.5
# Servidor ntfy (o tópico é cadastrado por rota no site)
NTFY_SERVER=https://ntfy.sh
MAX_CONSECUTIVE_ERRORS=5
